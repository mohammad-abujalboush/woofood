### ---------------------------------------------------------
### STEP 1: CREATE THE STORE IN THE NEW DATABASE
### ---------------------------------------------------------
POST {{baseUrl}}/Admin/tenants
Content-Type: application/json
X-Api-Key: {{masterKey}}

{
  "id": "{{tenantId}}",
  "name": "Kid You Knot Baby Store",
  "wooCommerceBaseUrl": "https://smart.kidyouknot.com/",
  "foodicsBaseUrl": "https://api-sandbox.foodics.com/"
}

### ---------------------------------------------------------
### STEP 2: GET FRESH FOODICS TOKENS
### ---------------------------------------------------------
POST https://api-sandbox.foodics.com/oauth/token
Content-Type: application/json

{
  "grant_type": "authorization_code",
  "client_id": "9d949103-d90b-4d0e-99ea-28d298f3d10c",
  "client_secret": "m70D5N48x47IPWfX7twIrw4BkKHV1StkV4eD3aoY",
  "code": "",
  "redirect_uri": "https://console-sandbox.foodics.com/dashboard"
}

